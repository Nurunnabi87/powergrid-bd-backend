# ---------- Server ----------
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Database (Neon PostgreSQL) ----------
# DATABASE_URL is the POOLED connection used by the app at runtime.
# DIRECT_URL is the UNPOOLED connection used by prisma migrate.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------- JWT ----------
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ---------- Google (GCP) Social Login ----------
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ---------- Redis (Upstash) - optional, app degrades gracefully ----------
REDIS_URL=

# ---------- bKash Tokenized Checkout (public sandbox credentials) ----------
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/bkash/callback

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email (optional, logs to console when unset) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PowerGrid BD <no-reply@powergrid.bd>"
